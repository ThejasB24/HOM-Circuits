      "{'0101': 76, '1011': 306, '0000': 116, '1010': 65, '1001': 107, '0010': 283, '0110': 108, '0011': 3501, '0001': 275, '1100': 3547, '0100': 357, '1101': 280, '1111': 108, '0111': 289, '1000': 314, '1110': 268}\n"

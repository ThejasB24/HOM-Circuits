   "source": [
    "# HOM JW with noise model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "424a156d-8122-4362-a129-5dc5cfe01ca6",
   "metadata": {},
   "outputs": [

   ],
   "source": [
    "import numpy as np\n",
    "from qiskit import QuantumCircuit, transpile\n",
    "from qiskit.quantum_info import SparsePauliOp, Operator, Pauli\n",
    "from qiskit.circuit.library import PauliEvolutionGate\n",
    "from qiskit.quantum_info import Operator\n",
    "from qiskit.visualization import plot_histogram\n",
    "from qiskit.synthesis import LieTrotter\n",
    "from qiskit_aer import AerSimulator\n",
    "from IPython.display import display, Math\n",
    "import matplotlib.pyplot as plt\n",
    "%matplotlib inline\n",
    "from qiskit import QuantumCircuit, transpile\n",
    "from qiskit.visualization import plot_histogram\n",
    "from qiskit_aer import AerSimulator\n",
    "from qiskit_aer.noise import NoiseModel, depolarizing_error, \\\n",
    "    amplitude_damping_error, phase_damping_error, ReadoutError\n",
    "\n",
    "X=Operator(Pauli(\"X\")).data\n",
    "Y=Operator(Pauli(\"Y\")).data\n",
    "Z=Operator(Pauli(\"Z\")).data\n",
    "I=np.eye(2,dtype=complex)\n",
    "\n",
    "sigma_plus=0.5*(X - 1j*Y)\n",
    "sigma_minus=0.5*(X + 1j*Y)\n",
    "\n",
    "n=8\n",
    "\n",
    "def creop(position):\n",
    "    ops=[Z]*position + [sigma_plus] + [I]*(n-position-1)\n",
    "    full=ops[0]\n",
    "    for o in ops[1:]:\n",
    "        full=np.kron(full,o)\n",
    "    return full\n",
    "\n",
    "def aniop(position):\n",
    "    ops=[Z]*position + [sigma_minus] + [I]*(n-position-1)\n",
    "    full=ops[0]\n",
    "    for o in ops[1:]:\n",
    "        full=np.kron(full,o)\n",
    "    return full\n",
    "    \n",
    "H=(np.pi/4)*(creop(0)@aniop(4) + creop(4)@aniop(0) +creop(1)@aniop(5) +creop(5)@aniop(1) \n",
    "             +creop(2)@aniop(6) +creop(6)@aniop(2) +creop(3)@aniop(7) +creop(7)@aniop(3) )\n",
    "\n",
    "H_P= SparsePauliOp.from_operator(Operator(H))\n",
    "H_P=H_P.simplify()\n",
    "print(H_P)\n",
    "\n",
    "def initial_state(theta):\n",
    "    zeta=np.cos(theta/2)\n",
    "    xi= -np.sin(theta/2)\n",
    "    initial_op= (1/np.sqrt(2))*((zeta*(creop(0)@creop(6)- creop(2)@creop(4))+ xi*(creop(0)@creop(7)- creop(2)@creop(5))))\n",
    "    vac=np.zeros(2**n, dtype=complex)\n",
    "    vac[0]=1.0\n",
    "    statevec=initial_op@vac\n",
    "    return statevec\n",
    "\n",
    "def HOMdip_circuit(theta):\n",
    "    qc=QuantumCircuit(8,8)\n",
    "    qc.initialize(initial_state(theta),range(8))\n",
    "    qc.barrier()\n",
    "    evolution= PauliEvolutionGate(H_P,time=1,label=\"U_B\")\n",
    "    qc.append(evolution,range(n))\n",
    "    qc.barrier()\n",
    "    qc.measure(range(n),range(n))\n",
    "    return qc\n",
    "\n",
    "def coincidence_probability(counts, shots):\n",
    "    total = 0\n",
    "    for bitstring, c in counts.items():\n",
    "        bits = bitstring[::-1]   \n",
    "        m1 = sum(int(b) for b in bits[0:4])\n",
    "        m2 = sum(int(b) for b in bits[4:8])\n",
    "        if m1 == 1 and m2 == 1:\n",
    "            total += c\n",
    "    return total / shots\n",
    "    \n",
    "\n",
    "relaxation_time   = 300e-6\n",
    "dephasing_time    = 200e-6\n",
    "\n",
    "single_qubit_gate_duration = 90e-9\n",
    "two_qubit_gate_duration    = 200e-9\n",
    "\n",
    "measurement_flip_prob = 0.0536\n",
    "two_qubit_depol_rate  = 0.00879\n",
    "\n",
    "noise_model = NoiseModel()\n",
    "\n",
    "gamma_1q  = 1 - np.exp(-single_qubit_gate_duration / relaxation_time)\n",
    "lambda_1q = 1 - np.exp(-single_qubit_gate_duration / dephasing_time)\n",
    "\n",
    "single_qubit_channel = (\n",
    "    amplitude_damping_error(gamma_1q)\n",
    "    .compose(phase_damping_error(lambda_1q))\n",
    ")\n",
    "noise_model.add_all_qubit_quantum_error(single_qubit_channel, [\"h\"])\n",
    "\n",
    "gamma_2q  = 1 - np.exp(-two_qubit_gate_duration / relaxation_time)\n",
    "lambda_2q = 1 - np.exp(-two_qubit_gate_duration / dephasing_time)\n",
    "\n",
    "thermal_2q = (\n",
    "    amplitude_damping_error(gamma_2q)\n",
    "    .tensor(amplitude_damping_error(gamma_2q))\n",
    "    .compose(\n",
    "        phase_damping_error(lambda_2q)\n",
    "        .tensor(phase_damping_error(lambda_2q))\n",
    "    )\n",
    ")\n",
    "noise_model.add_all_qubit_quantum_error(\n",
    "    depolarizing_error(two_qubit_depol_rate, 2).compose(thermal_2q), [\"cx\"]\n",
    ")\n",
    "\n",
    "confusion = [\n",
    "    [1 - measurement_flip_prob, measurement_flip_prob],\n",
    "    [measurement_flip_prob,     1 - measurement_flip_prob],\n",
    "]\n",
    "noise_model.add_all_qubit_readout_error(ReadoutError(confusion))\n",
    "\n",
    "backend = AerSimulator(noise_model=noise_model)\n",
    "\n",
    "\n",
    "shots=10000\n",
    "thetas=np.linspace(-np.pi,np.pi,100)\n",
    "coincidences=[]\n",
    "\n",
    "for theta in thetas:\n",
    "    qc=HOMdip_circuit(theta)\n",
    "    compiled=transpile(qc,backend)\n",
    "    job=backend.run(compiled, shots=shots)\n",
    "    result=job.result()\n",
    "    counts=result.get_counts()\n",
    "    coincidences.append(coincidence_probability(counts,shots))\n",
    "\n",
    "plt.plot(thetas, coincidences, 'o-')\n",
    "plt.xlabel(\"theta\")\n",
    "plt.ylabel(\"Coincidence probability\")\n",
    "plt.title(\"HOM dip\")\n",
    "plt.show()"
   ]
  },

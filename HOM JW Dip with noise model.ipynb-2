   "metadata": {},
   "source": [
    "# HOM JW Dip with noise model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "dea93055-51db-4ddd-916c-cd3ca54b21e0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "SparsePauliOp(['IIIXZZZX', 'IIIYZZZY', 'IIXZZZXI', 'IIYZZZYI', 'IXZZZXII', 'IYZZZYII', 'XZZZXIII', 'YZZZYIII'],\n",
      "              coeffs=[0.39269908+0.j, 0.39269908+0.j, 0.39269908+0.j, 0.39269908+0.j,\n",
      " 0.39269908+0.j, 0.39269908+0.j, 0.39269908+0.j, 0.39269908+0.j])\n"
     ]
    },
    {
     "data": {

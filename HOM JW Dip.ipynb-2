   "id": "6fcf23d9-fdb9-41cb-b27c-f7e7ac67e5c9",
   "metadata": {},
   "source": [
    "# HOM JW Dip\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "fcb44180-88d3-4c51-a622-8760b56e0ac8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "SparsePauliOp(['IIIXZZZX', 'IIIYZZZY', 'IIXZZZXI', 'IIYZZZYI', 'IXZZZXII', 'IYZZZYII', 'XZZZXIII', 'YZZZYIII'],\n",
      "              coeffs=[0.39269908+0.j, 0.39269908+0.j, 0.39269908+0.j, 0.39269908+0.j,\n",
      " 0.39269908+0.j, 0.39269908+0.j, 0.39269908+0.j, 0.39269908+0.j])\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import numpy as np\n",
    "from qiskit import QuantumCircuit, transpile\n",
    "from qiskit.quantum_info import SparsePauliOp, Operator, Pauli\n",
    "from qiskit.circuit.library import PauliEvolutionGate\n",
    "from qiskit.quantum_info import Operator\n",
    "from qiskit.visualization import plot_histogram\n",
    "from qiskit.synthesis import LieTrotter\n",
    "from qiskit_aer import AerSimulator\n",
    "from IPython.display import display, Math\n",
    "from qiskit_ibm_runtime.fake_provider import FakeMarrakesh\n",
    "import matplotlib.pyplot as plt\n",
    "%matplotlib inline\n",
    "\n",
    "X=Operator(Pauli(\"X\")).data\n",
    "Y=Operator(Pauli(\"Y\")).data\n",
    "Z=Operator(Pauli(\"Z\")).data\n",
    "I=np.eye(2,dtype=complex)\n",
    "\n",
    "sigma_plus=0.5*(X - 1j*Y)\n",
    "sigma_minus=0.5*(X + 1j*Y)\n",
    "\n",
    "n=8\n",
    "\n",
    "def creop(position):\n",
    "    ops=[Z]*position + [sigma_plus] + [I]*(n-position-1)\n",
    "    full=ops[0]\n",
    "    for o in ops[1:]:\n",
    "        full=np.kron(full,o)\n",
    "    return full\n",
    "\n",
    "def aniop(position):\n",
    "    ops=[Z]*position + [sigma_minus] + [I]*(n-position-1)\n",
    "    full=ops[0]\n",
    "    for o in ops[1:]:\n",
    "        full=np.kron(full,o)\n",
    "    return full\n",
    "    \n",
    "H=(np.pi/4)*(creop(0)@aniop(4) + creop(4)@aniop(0) +creop(1)@aniop(5) +creop(5)@aniop(1) \n",
    "             +creop(2)@aniop(6) +creop(6)@aniop(2) +creop(3)@aniop(7) +creop(7)@aniop(3) )\n",
    "\n",
    "H_P= SparsePauliOp.from_operator(Operator(H))\n",
    "H_P=H_P.simplify()\n",
    "print(H_P)\n",
    "\n",
    "def initial_state(theta):\n",
    "    zeta=np.cos(theta/2)\n",
    "    xi= -np.sin(theta/2)\n",
    "    initial_op= (1/np.sqrt(2))*((zeta*(creop(0)@creop(6)- creop(2)@creop(4))+ xi*(creop(0)@creop(7)- creop(2)@creop(5))))\n",
    "    vac=np.zeros(2**n, dtype=complex)\n",
    "    vac[0]=1.0\n",
    "    statevec=initial_op@vac\n",
    "    return statevec\n",
    "\n",
    "def HOMdip_circuit(theta):\n",
    "    qc=QuantumCircuit(8,8)\n",
    "    qc.initialize(initial_state(theta),range(8))\n",
    "    qc.barrier()\n",
    "    evolution= PauliEvolutionGate(H_P,time=1,label=\"U_B\")\n",
    "    qc.append(evolution,range(n))\n",
    "    qc.barrier()\n",
    "    qc.measure(range(n),range(n))\n",
    "    return qc\n",
    "\n",
    "COINC= ['00010001', '00010010', '00010100', '00011000',\n",
    "    '00100001', '00100010', '00100100', '00101000',\n",
    "    '01000001', '01000010', '01000100', '01001000',\n",
    "    '10000001', '10000010', '10000100', '10001000']\n",
    "\n",
    "\n",
    "backend=AerSimulator()\n",
    "#backend=FakeMarrakesh()\n",
    "\n",
    "thetas = np.linspace(-np.pi, np.pi, 100)\n",
    "shots =10000\n",
    "\n",
    "coinc = []\n",
    "\n",
    "for th in thetas:\n",
    "    t = transpile(HOMdip_circuit( theta=th))    \n",
    "    c = backend.run(t, shots=shots).result().get_counts()\n",
    "    coinc.append(sum(c.get(s, 0) for s in COINC) / shots)\n",
    "\n",
    "plt.plot(thetas, coinc, 'o', label=\"HOM coincidence\")\n",
    "plt.xlabel(r\"$\\theta$\")\n",
    "plt.plot(thetas, np.sin(thetas/2)**2/2, 'k--', label=r\"theory $\\cos^2\\theta/2$\")\n",
    "\n",
    "plt.ylabel(\"Coincidence probability\")\n",
    "plt.show()\n",
    "\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "bad958d6-c926-4081-8787-87a1fda5d243",

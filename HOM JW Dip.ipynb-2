   "source": [
    "theta_list=np.linspace(-np.pi,np.pi,33)\n",
    "for t in theta_list:\n",
    "    qc=HOMdip_circuit(t)\n",
    "    compiled=transpile(qc,backend)\n",
    "    job=backend.run(compiled, shots=shots)\n",
    "    result=job.result()\n",
    "    counts=result.get_counts()\n",
    "    plot_histogram(counts)\n",
    "    plt.show()\n"
   ]
  },

      "  0.13884009+0.j,  0.19634954+0.j, -0.19634954+0.j,  0.13884009+0.j,\n",
      " -0.13884009+0.j, -0.19634954+0.j,  0.19634954+0.j, -0.13884009+0.j,\n",
      "  0.09817477+0.j,  0.13884009+0.j, -0.13884009+0.j,  0.09817477+0.j,\n",
      "  0.09817477+0.j,  0.13884009+0.j, -0.13884009+0.j,  0.09817477+0.j])\n",

   "source": [
    "display(Math(r\"U_B= \\exp\\!\\left[i\\theta \\left(\\hat{b}^\\dagger\\hat{a}+\\hat{b}\\hat{a}^\\dagger\\right)\\right]\"))\n",
    "BScircuit(1).draw(\"mpl\")\n",
    "plt.show()"
   ]
  },
